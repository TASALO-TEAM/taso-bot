# =============================================================================
# TASALO-BOT — Variables de Entorno
# =============================================================================
# Copia este archivo a .env y configura los valores para tu entorno.
# 
# cp .env.example .env
#
# Todos los valores son requeridos a menos que se indique lo contrario.
# =============================================================================


# =============================================================================
# TELEGRAM — Configuración del Bot
# =============================================================================

# Token del bot obtenido de @BotFather en Telegram.
# 
# Cómo obtenerlo:
#   1. Abre Telegram y busca @BotFather
#   2. Envía /newbot y sigue las instrucciones
#   3. Copia el token que te devuelve (tiene formato: 1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw)
#
# ⚠️ NUNCA compartas este token. Mantén tu .env seguro.
TELEGRAM_BOT_TOKEN=your_bot_token_here


# =============================================================================
# ADMINISTRADORES — Control de Acceso
# =============================================================================

# IDs de chat de administradores separados por coma.
#
# Los administradores pueden usar comandos privilegiados:
#   - /refresh: Fuerza refresco inmediato de tasas en el backend
#   - /status: Muestra estado del scheduler del backend
#   - /health: Verifica conexión con el backend
#
# Cómo obtener tu user_id:
#   1. Busca @userinfobot en Telegram
#   2. Inicia el bot y te mostrará tu ID numérico
#   3. Copia ese número aquí
#
# Formato: "123456789" o "123456789,987654321" para múltiples admins
# Ejemplo: ADMIN_CHAT_IDS=123456789,987654321
ADMIN_CHAT_IDS=


# =============================================================================
# BACKEND API — Conexión con taso-api
# =============================================================================

# URL base de la API de taso-api.
#
# Desarrollo local:
#   TASALO_API_URL=http://localhost:8040
#
# Producción (con dominio):
#   TASALO_API_URL=https://api.tasalo.app
#
# Producción (con IP):
#   TASALO_API_URL=http://192.168.1.100:8040
#
# ⚠️ El bot debe poder alcanzar esta URL desde donde se ejecute.
TASALO_API_URL=http://localhost:8040


# API key para endpoints administrativos del backend.
#
# Este valor debe ser IDÉNTICO al ADMIN_API_KEY configurado en taso-api.
# 
# Cómo configurarlo:
#   1. En taso-api, edita .env y establece ADMIN_API_KEY=tu_clave_secreta
#   2. Aquí, establece TASALO_ADMIN_KEY=tu_clave_secreta (mismo valor)
#
# ⚠️ Usa una clave segura (mínimo 32 caracteres, mezcla de letras, números).
#   Genera una con: openssl rand -hex 32
#
# Si no se configura, los comandos /refresh y /status no funcionarán.
TASALO_ADMIN_KEY=


# =============================================================================
# CRIPTOMONEDAS — CoinMarketCap (comando /p)
# =============================================================================

# API Key de CoinMarketCap Pro para el comando /p.
#
# El comando /p consulta precios de criptomonedas (BTC, ETH, etc.) usando
# CoinMarketCap como fuente principal, con fallback a CryptoCompare.
#
# Cómo obtenerla:
#   1. Crea una cuenta en https://pro.coinmarketcap.com/
#   2. Suscríbete al plan Pro (hay plan gratuito con límites)
#   3. En tu dashboard, ve a "API Key" y copia la clave
#
# La clave se usa para consultar la quotes/latest endpoint (y los
# endpoints de mercado que arma /spl: fear-and-greed, global-metrics,
# listings, trending, altcoin-season).
# Sin esta clave, el comando /p no funcionará (devuelve "no se pudieron obtener datos").
#
# Nota: Las llamadas a CMC son limitadas según el plan. El bot cae a
# CryptoCompare (gratuito) si CMC falla, pero con datos reducidos.
#
# Soporta VARIAS keys separadas por coma para repartir carga entre
# distintas cuentas del plan Basic (cada una con su propio límite de
# llamadas/minuto y créditos/mes). El bot rota automáticamente entre
# ellas, y salta a la siguiente si una devuelve 429 (rate limit). Este
# es el pool INTERACTIVO, usado por /p y /spl.
#
#   Una sola key:  COINMARKETCAP_API_KEY=your_cmc_pro_api_key_here
#   Varias keys:   COINMARKETCAP_API_KEY=key1,key2,key3
COINMARKETCAP_API_KEY=

# (Opcional) Pool DEDICADO al alert checker (job automático cada 5 min
# que verifica las alertas de precio de todos los usuarios) — separado
# del pool interactivo de arriba para que el polling en background no
# consuma el cupo de /p y /spl. Mismo formato (una o varias separadas
# por coma). Si se deja vacío, el checker usa el pool de
# COINMARKETCAP_API_KEY (comportamiento idéntico al anterior).
CMC_API_KEY_ALERTA=

# API Key de CoinGecko (plan Demo) para enriquecer el comando /p.
#
# CoinGecko se consulta EN PARALELO a CoinMarketCap. Sus datos (ATH/ATL,
# supply circulante, categoría del proyecto) se muestran en el botón
# "📋 Ver más" del mensaje de /p, sin pisar los campos que ya provee CMC.
#
# Cómo obtenerla:
#   1. Crea una cuenta en https://www.coingecko.com/en/api/pricing
#   2. Activa el plan Demo (gratis, 30 calls/min)
#   3. Genera tu key en el dashboard (formato: CG-xxxxxxxxxxxxxxxxxxxxxxxx)
#
# Soporta VARIAS keys separadas por coma para repartir carga entre distintas
# cuentas del plan Demo (cada una con su propio límite de 30 calls/min). El
# bot rota automáticamente entre ellas en cada petición, y salta a la
# siguiente si una devuelve 429 (rate limit).
#
#   Un solo valor:  COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx
#   Varias keys:    COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx,CG-yyyyyyyyyyyyyyyyyyyyyyyy
#
# Si se deja vacía, /p sigue funcionando igual que antes (solo CMC/CryptoCompare),
# simplemente sin el botón "Ver más".
COINGECKO_API_KEY=

# =============================================================================
# GROQ — Análisis con IA (comando /ta)
# =============================================================================

# API key de Groq para el botón "🤖 Análisis IA Profesional" en /ta.
#
# Cómo obtenerla:
#   1. Crea cuenta en https://console.groq.com
#   2. Ve a "API Keys" y crea una nueva key
#   3. Copia la clave (formato: gsk_...)
#
# Modelo usado: openai/gpt-oss-20b (gratis, rápido)
# Alternativa: llama-3.3-70b-versatile (más potente, también gratis)
#
# ⚠️ Esta clave se usa para llamadas de análisis técnico con IA
# (/ta, /p y /spl comparten el mismo cliente). Mantenla secreta. No la
# compartas ni la commitees.
#
# Soporta varias keys separadas por coma para repartir carga entre
# distintas cuentas gratuitas de Groq. El bot rota automáticamente
# entre ellas, y salta a la siguiente si una devuelve 429 (rate limit).
#
#   Una sola key:  GROQ_API_KEY=gsk_xxxxxxxx
#   Varias keys:   GROQ_API_KEY=gsk_xxxxxxxx,gsk_yyyyyyyy
GROQ_API_KEY=


# =============================================================================
# SISTEMA DE ANUNCIOS (/ads)
# =============================================================================

# Kill-switch global del sistema de anuncios.
#
# Si es "false", el bot NUNCA inyecta un anuncio en ningún mensaje, aunque
# haya anuncios activos en la base de datos. Útil para apagar todo al instante
# sin tener que desactivar anuncios uno por uno.
#
# El comando /ads (gestión de anuncios) sigue funcionando igual, esto solo
# controla si se inyectan en los mensajes de precios/tasas/alertas.
ADS_ENABLED=true


# =============================================================================
# TIMEOUTS — Configuración de Red
# =============================================================================
#
# Timeout para llamadas HTTP a la API en segundos.
# Rango válido: 5-60 segundos
# Valor recomendado: 15 (equilibrio entre paciencia y UX)
#
# Si la API no responde en este tiempo, el bot muestra error al usuario.
# Aumentar solo si tu backend es consistentemente lento.
API_TIMEOUT_SECONDS=15


# =============================================================================
# LOGGING — Depuración y Monitoreo
# =============================================================================

# Nivel de logging para la salida estándar (stdout).
#
# Niveles disponibles:
#   - DEBUG:   Mensajes detallados para desarrollo (muy verboso)
#   - INFO:    Mensajes informativos (producción estándar)
#   - WARNING: Solo advertencias y errores
#   - ERROR:   Solo errores críticos
#
# Recomendado:
#   - Desarrollo: DEBUG
#   - Producción: INFO
LOG_LEVEL=INFO


# =============================================================================
# WEBHOOK — Modo Webhook vs Polling (Opcional)
# =============================================================================

# Modo de operación del bot.
#
# Opciones:
#   - "true":  Usa webhook (producción, menor latencia <100ms)
#   - "false": Usa polling (desarrollo, default)
#
# ⚠️ Para webhook, necesitas un servidor accesible desde internet.
# Genera el secret token con: openssl rand -hex 32
USE_WEBHOOK=false


# URL completa del webhook (requerido si USE_WEBHOOK=true).
#
# Ejemplo: https://tu-dominio.com/webhook
# Debe ser accesible desde los servidores de Telegram.
WEBHOOK_URL=


# Dominio del webhook (sin https://).
#
# Ejemplo: tu-dominio.com
WEBHOOK_DOMAIN=


# Puerto en el que el bot escuchará webhooks.
#
# Default: 8443
# Asegúrate de que este puerto esté abierto en el firewall.
WEBHOOK_PORT=8443


# Token secreto para validar webhooks de Telegram.
#
# Genera uno seguro con: openssl rand -hex 32
# Este token se envía en el header X-Telegram-Bot-Api-Secret-Token
# y se usa para verificar que las peticiones vienen de Telegram.
#
# ⚠️ NUNCA hardcodees este valor. Usa un token único por entorno.
TELEGRAM_SECRET_TOKEN=


# =============================================================================
# EJEMPLOS DE CONFIGURACIÓN
# =============================================================================
#
# ─────────────────────────────────────────────────────────────────────────────
# DESARROLLO LOCAL (Polling)
# ─────────────────────────────────────────────────────────────────────────────
#
# TELEGRAM_BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
# ADMIN_CHAT_IDS=123456789
# TASALO_API_URL=http://localhost:8040
# TASALO_ADMIN_KEY=dev_key_no_segura_para_produccion
# COINMARKETCAP_API_KEY=your_cmc_pro_api_key_here
# API_TIMEOUT_SECONDS=15
# LOG_LEVEL=DEBUG
# USE_WEBHOOK=false
#
# ─────────────────────────────────────────────────────────────────────────────
# PRODUCCIÓN (Webhook en VPS)
# ─────────────────────────────────────────────────────────────────────────────
#
# TELEGRAM_BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
# ADMIN_CHAT_IDS=123456789,987654321
# TASALO_API_URL=http://127.0.0.1:8040
# TASALO_ADMIN_KEY=genera_con_openssl_rand_hex_32
# COINMARKETCAP_API_KEY=your_cmc_pro_api_key_here
# API_TIMEOUT_SECONDS=15
# LOG_LEVEL=INFO
# USE_WEBHOOK=true
# WEBHOOK_URL=https://tasalo.duckdns.org/webhook
# WEBHOOK_DOMAIN=tasalo.duckdns.org
# WEBHOOK_PORT=8443
# TELEGRAM_SECRET_TOKEN=<openssl rand -hex 32>
#
# ─────────────────────────────────────────────────────────────────────────────
# PRODUCCIÓN (Docker con taso-api en misma red)
# ─────────────────────────────────────────────────────────────────────────────
#
# TELEGRAM_BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
# ADMIN_CHAT_IDS=123456789
# TASALO_API_URL=http://taso-api:8040
# TASALO_ADMIN_KEY=${TASALO_ADMIN_KEY_FROM_SECRETS}
# COINMARKETCAP_API_KEY=${COINMARKETCAP_API_KEY_FROM_SECRETS}
# API_TIMEOUT_SECONDS=15
# LOG_LEVEL=INFO
# USE_WEBHOOK=false
#
# =============================================================================
